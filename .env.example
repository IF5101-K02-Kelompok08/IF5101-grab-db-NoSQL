COUCHDB_USER=dev_admin
COUCHDB_PASSWORD=change-this-local-password
COUCHDB_URL=http://127.0.0.1:5984
# Least-privileged user that the CouchDB operations and benchmark run as. couchdb.load
# creates it (role grab_app). Leave empty to run everything as the admin.
COUCHDB_APP_USER=grab_app
COUCHDB_APP_PASSWORD=change-this-app-password
# Databases are named <prefix>_orders, <prefix>_fleet, <prefix>_customers, <prefix>_geo.
COUCHDB_DB_PREFIX=grab
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
